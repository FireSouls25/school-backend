# Copy to .env and adjust. Compose reads it automatically.
# .env is gitignored; .env.example is the documented reference.

# --- deployment shape -------------------------------------------------------
# development: handy defaults, demo data allowed.
# production:  enforces Validate() — real database required, SEED_DEMO
#              forced off, known dev passwords rejected.
APP_ENV=development

# Published API port on the host.
API_PORT=8080

# --- database ---------------------------------------------------------------
# Leave DATABASE_URL empty to run entirely in memory (development only:
# every restart wipes the data). Compose builds the DSN from these.
POSTGRES_USER=grade
POSTGRES_PASSWORD=grade
POSTGRES_DB=gradedb
POSTGRES_PORT=5433
# DATABASE_URL=postgres://grade:grade@localhost:5433/gradedb?sslmode=disable

# --- CORS -------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API. Empty means
# same-origin only, which is what a production deployment behind the same
# domain wants.
ALLOWED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420

# --- demo data (development only) -------------------------------------------
# Creates a demo school on boot: teachers, subjects, classes, students,
# enrollments, roll calls with marks, one warning and one fault, plus the
# two logins the SPA dev build expects. Idempotent. Ignored (forced off)
# when APP_ENV=production.
SEED_DEMO=true

# --- first admin ------------------------------------------------------------
# Created at boot so an empty installation has someone who can create
# users. Ignored when the account already exists.
#
# Use a unique password in production: the known development passwords
# (admin123*, docente123*) are rejected by APP_ENV=production.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@observador.edu.co
BOOTSTRAP_ADMIN_PASSWORD=admin123*

# Prefer a secret file over an env var where your platform supports it
# (docker secrets, Kubernetes). Takes precedence over the value above.
# BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/bootstrap_admin_password

# --- legacy test hook -------------------------------------------------------
# Grants roles to raw subject UUIDs, for the placeholder identity
# (X-Subject-ID) used before real authentication. Prefer real accounts.
# SEED_ADMINS=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa
# SEED_TEACHERS=bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb